# Rushi CRM Platform v2.0 — Production Environment Template
# NEVER commit real production secrets to git.

# -----------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# -----------------------------------------------------------------------------
# Public Supabase / NeoDB PostgREST endpoint
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co

# Public Anonymous client key (Safe for browser exposure under RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application settings
VITE_APP_ENV=production
VITE_APP_TIMEZONE=Asia/Kolkata
VITE_DEFAULT_LOCALE=mr

# -----------------------------------------------------------------------------
# 2. BACKEND & SCHEDULED WORKER ENVIRONMENT VARIABLES (Render / Server-only)
# -----------------------------------------------------------------------------
# Direct NeoDB PostgreSQL Connection String
DATABASE_URL=postgresql://<user>:<password>@<neodb-host>:5432/<dbname>?sslmode=require

# Supabase Service Role Key (CRITICAL: Server-only for background reminder/backup schedulers)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Private Storage Buckets
STORAGE_BACKUP_BUCKET=private-backups
STORAGE_DOCUMENT_BUCKET=private-documents

# Application Base URL (e.g., https://rushi-crm.vercel.app)
APP_BASE_URL=https://<your-vercel-domain>.vercel.app
BUSINESS_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# 3. OPTIONAL OFFICIAL WHATSAPP API (Disabled by default; Manual mode is free)
# -----------------------------------------------------------------------------
# WHATSAPP_MODE=manual_handoff
# WHATSAPP_PROVIDER_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
