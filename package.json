{
  "name": "rushi-crm",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Rushi CRM Platform — Cattle Feed and PVC business management",
  "scripts": {
    "dev": "vite",
    "server": "node server.mjs",
    "start": "node server.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css,json}\" \"*.{ts,js,json,cjs}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css,json}\" \"*.{ts,js,json,cjs}\"",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude \"tests/integration/**\"",
    "test:rls": "vitest run tests/integration/rls/rls-postgres.integration.test.ts",
    "test:integration": "npm run test:rls",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:deployment": "node scripts/verify-deployment.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate:neodb": "node scripts/migrate-neodb.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "cd android && .\\gradlew.bat assembleDebug",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@supabase/supabase-js": "^2.49.0",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "i18next": "^24.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "pg": "^8.23.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0",
    "workbox-window": "^7.3.0"
  }
}
